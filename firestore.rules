rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: Firestore users/{uid}.isAdmin and/or Auth custom claim admin (optional).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'true' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 1
          )
        )
      );
    }

    // Cricket insight answers: only while match is not completed (match doc status != 'completed')
    function insightMatchNotCompleted(questionId) {
      return exists(/databases/$(database)/documents/cricket_questions/$(questionId)) &&
        (
          get(/databases/$(database)/documents/cricket_questions/$(questionId)).data.matchId == null ||
          !exists(/databases/$(database)/documents/matches/$(get(/databases/$(database)/documents/cricket_questions/$(questionId)).data.matchId)) ||
          get(/databases/$(database)/documents/matches/$(get(/databases/$(database)/documents/cricket_questions/$(questionId)).data.matchId)).data.status != 'completed'
        );
    }

    // Match prediction cutoff (Timestamp); set when admin saves match. If missing, legacy matches skip this check.
    function matchPredictionWindowOpen(matchId) {
      return !exists(/databases/$(database)/documents/matches/$(matchId)) ||
        get(/databases/$(database)/documents/matches/$(matchId)).data.predictionCutoffAt == null ||
        request.time < get(/databases/$(database)/documents/matches/$(matchId)).data.predictionCutoffAt;
    }

    // First-time prediction allowed until firstPredictionGraceEndsAt (cutoff + extra minutes); set when admin saves match.
    function matchFirstPredictionWindowOpen(matchId) {
      return !exists(/databases/$(database)/documents/matches/$(matchId)) ||
        (
          get(/databases/$(database)/documents/matches/$(matchId)).data.firstPredictionGraceEndsAt != null &&
          request.time < get(/databases/$(database)/documents/matches/$(matchId)).data.firstPredictionGraceEndsAt
        ) ||
        (
          get(/databases/$(database)/documents/matches/$(matchId)).data.firstPredictionGraceEndsAt == null &&
          matchPredictionWindowOpen(matchId)
        );
    }

    // settings/cricketInsights: allowInsightQuestionsAfterPredictionCutoff / allowInsightAnswersAfterPredictionCutoff
    function cricketInsightsAllowQuestionsAfterCutoff() {
      return exists(/databases/$(database)/documents/settings/cricketInsights) &&
        get(/databases/$(database)/documents/settings/cricketInsights).data.allowInsightQuestionsAfterPredictionCutoff == true;
    }

    function cricketInsightsAllowAnswersAfterCutoff() {
      return exists(/databases/$(database)/documents/settings/cricketInsights) &&
        get(/databases/$(database)/documents/settings/cricketInsights).data.allowInsightAnswersAfterPredictionCutoff == true;
    }

    function matchAllowsInsightQuestions(matchId) {
      return matchId == null || matchPredictionWindowOpen(matchId) || cricketInsightsAllowQuestionsAfterCutoff();
    }

    function insightAnswersMatchPredictionOpen(questionId) {
      let mid = get(/databases/$(database)/documents/cricket_questions/$(questionId)).data.matchId;
      return mid == null || matchPredictionWindowOpen(mid) || cricketInsightsAllowAnswersAfterCutoff();
    }

    // True when this context exists and is still accepting predictions (only own response readable by non-admins).
    function predictionContextPicksAreOpen(contextId) {
      return exists(/databases/$(database)/documents/prediction_contexts/$(contextId)) &&
        (
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == true ||
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == 'true' ||
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == 1
        );
    }

    // Set by admin when saving deadline (Timestamp). Legacy docs without deadlineAt rely on client-only checks.
    function predictionContextDeadlineHasPassed(contextId) {
      let ctx = get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data;
      return ctx.deadlineAt != null && request.time > ctx.deadlineAt;
    }

    // OTP verification during registration
    match /otps/{docId} {
      allow read, write: if true;
    }

    // Username to email lookup (needed for login)
    match /usernameLookup/{username} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Users: any logged-in user can READ all users (for leaderboard, admin calculate points)
    // Unauthenticated read allowed for forgot-password flow (lookup by email/username, check reset limit)
    // Users can WRITE and DELETE their own document (for account surrender); admin can DELETE any user
    match /users/{userId} {
      allow read: if true;
      // seasonContestLeaderboard is written only by admins (contest winner bonuses for main leaderboard)
      allow create: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['seasonContestLeaderboard']);
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['seasonContestLeaderboard'])
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /settings/{docId} {
      allow read: if request.auth != null || docId == 'passwordPolicy';
      allow write: if isAdmin();
    }

    match /teams/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /rules/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /matches/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Predictions: any logged-in user can READ all (admin needs this for calculate points)
    // Create: until first-pick grace end. Update: only until strict cutoff (no grace for changes).
    match /predictions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'matchId', 'predictedWinner']) &&
        matchFirstPredictionWindowOpen(request.resource.data.matchId);
      allow update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.matchId == resource.data.matchId &&
        matchPredictionWindowOpen(resource.data.matchId);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Cricket Insights approvers (admin adds via Program Config; doc id = userId)
    match /insight_approvers/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Cricket Insights: questions (users create; admin/approvers can approve; only admin can delete)
    // Only admins may change answersDisabled / answersDisabledAt / answersDisabledBy.
    match /cricket_questions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        matchAllowsInsightQuestions(request.resource.data.matchId);
      allow update: if isAdmin() ||
        (request.auth != null && exists(/databases/$(database)/documents/insight_approvers/$(request.auth.uid)) &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['answersDisabled', 'answersDisabledAt', 'answersDisabledBy']));
      allow delete: if isAdmin();
    }

    // Cricket Insights: answers (users answer once per question; not when question is closed by admin)
    match /cricket_answers/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/cricket_questions/$(request.resource.data.questionId)) &&
        get(/databases/$(database)/documents/cricket_questions/$(request.resource.data.questionId)).data.answersDisabled != true &&
        insightMatchNotCompleted(request.resource.data.questionId) &&
        insightAnswersMatchPredictionOpen(request.resource.data.questionId);
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid &&
        insightMatchNotCompleted(resource.data.questionId) &&
        insightAnswersMatchPredictionOpen(resource.data.questionId);
    }

    // Prediction contexts (e.g. quarter-final qualifiers): admin defines tiers; users submit team picks under open context
    // Deploy: firebase deploy --only firestore:rules (local file is ignored until deployed)
    match /prediction_contexts/{contextId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();

      // Own response always readable. Others' responses when picks are closed, or pick deadline has passed
      // (deadlineAt), so the participant list can load even if admin has not toggled acceptingPredictions yet.
      match /responses/{userId} {
        allow read: if request.auth != null && (
          isAdmin() ||
          request.auth.uid == userId ||
          !predictionContextPicksAreOpen(contextId) ||
          predictionContextDeadlineHasPassed(contextId)
        );
        allow create: if request.auth != null && request.auth.uid == userId &&
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.active == true &&
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == true &&
          !predictionContextDeadlineHasPassed(contextId);
        allow update: if isAdmin() ||
          (request.auth != null && request.auth.uid == userId &&
            get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.active == true &&
            get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == true &&
            !predictionContextDeadlineHasPassed(contextId));
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId &&
          get(/databases/$(database)/documents/prediction_contexts/$(contextId)).data.acceptingPredictions == true &&
          !predictionContextDeadlineHasPassed(contextId));
      }
    }
  }
}
